<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_controller_cpp</name>
  <version>0.0.0</version>
  <description>Узел автономного управления дроном для ArduPilot SITL. Реализует конечный автомат для взлёта, навигации по точкам и посадки с использованием DDS (MicroXRCEAgent).</description>
  <maintainer email="112532019+ituretsky@users.noreply.github.com">guy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>ardupilot_msgs</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
